generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Opd {
  id                  String               @id @default(cuid())
  code                String               @unique
  name                String
  shortName           String
  category            String               @default("Dinas Daerah")
  address             String?
  phone               String?
  email               String?
  activity1Name       String?
  activity2Name       String?
  users               User[]
  submissions         EpssSubmission[]
  schedules           CoachingSchedule[]
  targetedAssessments Assessment[]         @relation("TargetOpd")
  assessmentResponses AssessmentResponse[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  nip                 String?
  passwordHash        String
  role                String               @default("OPERATOR_OPD") // SUPERADMIN | PEMBINA_SEKTORAL | OPERATOR_OPD
  jabatan             String?
  phone               String?
  isActive            Boolean              @default(true)
  opdId               String?
  opd                 Opd?                 @relation(fields: [opdId], references: [id], onDelete: SetNull)
  uploadedDocs        EpssDocument[]
  reviewedSubmits     EpssSubmission[]     @relation("ReviewedBy")
  reviewComments      EpssReviewComment[]
  createdAssessments  Assessment[]         @relation("AssessmentAuthor")
  submittedResponses  AssessmentResponse[] @relation("ResponseSubmitter")
  reviewedResponses   AssessmentResponse[] @relation("ResponseReviewer")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model EpssPeriod {
  id          String   @id @default(cuid())
  year        Int      @unique
  label       String
  stage       String   @default("Tahap Penilaian Mandiri & Unggah Bukti")
  status      String   @default("AKTIF") // AKTIF | SELESAI | PERSIAPAN
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
}

model EpssDomain {
  id          String       @id @default(cuid())
  code        String       @unique // "1", "2", "3", "4", "5"
  name        String
  weight      Float        // 28, 24, 19, 17, 12
  description String?
  aspects     EpssAspect[]
}

model EpssAspect {
  id         String          @id @default(cuid())
  code       String          @unique // "101" .. "503"
  name       String
  weight     Float
  domainId   String
  domain     EpssDomain      @relation(fields: [domainId], references: [id], onDelete: Cascade)
  indicators EpssIndicator[]
}

model EpssIndicator {
  id             String           @id @default(cuid())
  code           String           @unique // "10101" .. "50303" (38 indicators)
  name           String
  weight         Float            // Weight within aspect (%)
  totalWeight    Float            // Effective weight in total IPS (%)
  aspectId       String
  aspect         EpssAspect       @relation(fields: [aspectId], references: [id], onDelete: Cascade)
  level1Criteria String
  level2Criteria String
  level3Criteria String
  level4Criteria String
  level5Criteria String
  notes          String?
  submissions    EpssSubmission[]
}

model EpssSubmission {
  id            String              @id @default(cuid())
  opdId         String
  opd           Opd                 @relation(fields: [opdId], references: [id], onDelete: Cascade)
  indicatorId   String
  indicator     EpssIndicator       @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  periodYear    Int                 @default(2026)
  targetLevel   Int                 @default(3)
  selfScore     Int?                // 1..5 self assessment by OPD
  maturityScore Int?                // 1..5 official score by Pembina Sektoral BPS
  narrative     String?             // (i) Relevansi & ringkasan, (ii) Nama file, (iii) Halaman
  pageReference String?
  status        String              @default("BELUM_DIISI") // BELUM_DIISI | DRAF | MENUNGGU_PERIKSA | REVISI | TERVERIFIKASI
  reviewerNotes String?
  reviewedById  String?
  reviewedBy    User?               @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  documents     EpssDocument[]
  comments      EpssReviewComment[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([opdId, indicatorId, periodYear])
}

model EpssDocument {
  id           String         @id @default(cuid())
  submissionId String
  submission   EpssSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fileName     String
  originalName String
  filePath     String         // e.g. /uploads/epss/2026/...
  mimeType     String
  fileSize     Int
  targetLevel  Int            @default(2)
  pageNumber   String?
  description  String?
  uploadedById String?
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
}

model EpssReviewComment {
  id           String         @id @default(cuid())
  submissionId String
  submission   EpssSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  scoreGiven   Int?
  statusAction String?
  comment      String
  createdAt    DateTime       @default(now())
}

model CoachingSchedule {
  id          String   @id @default(cuid())
  title       String
  topic       String
  description String?
  date        DateTime
  startTime   String
  endTime     String
  location    String
  mode        String   @default("TATAP_MUKA") // TATAP_MUKA | DARING | HIBRIDA
  status      String   @default("TERJADWAL")  // TERJADWAL | BERLANGSUNG | SELESAI | DITUNDA
  opdId       String?
  opd         Opd?     @relation(fields: [opdId], references: [id], onDelete: SetNull)
  pembinaName String
  participants Int     @default(15)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LearningMaterial {
  id             String   @id @default(cuid())
  title          String
  category       String   // Panduan EPSS | Regulasi & Kebijakan | Standar Data & Metadata | Template & Instrumen | Materi Sosialisasi | Video Pembinaan
  format         String   // PDF | DOCX | XLSX | PPTX | VIDEO | ZIP
  fileSize       String
  fileUrl        String
  targetAudience String   @default("Semua OPD")
  domainCode     String?
  isFeatured     Boolean  @default(false)
  description    String
  author         String   @default("Tim Pembina Statistik Sektoral BPS Kab. Berau")
  downloadCount  Int      @default(0)
  publishedLabel String   @default("Jan 2026")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Assessment {
  id          String               @id @default(cuid())
  title       String
  description String
  category    String               @default("Diagnostik Pra-EPSS") // Diagnostik Pra-EPSS | Kesiapan Metadata & Romantik | Evaluasi Pasca-Pembinaan
  periodYear  Int                  @default(2026)
  status      String               @default("AKTIF") // DRAF | AKTIF | DITUTUP
  dueDate     DateTime
  targetOpdId String?              // null = Semua OPD, atau ID OPD tertentu
  targetOpd   Opd?                 @relation("TargetOpd", fields: [targetOpdId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?                @relation("AssessmentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  questions   AssessmentQuestion[]
  responses   AssessmentResponse[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model AssessmentQuestion {
  id           String             @id @default(cuid())
  assessmentId String
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  order        Int
  domainCode   String             @default("Domain 1") // Domain 1..5 atau Umum
  indicatorRef String?            // e.g. "10101"
  questionText String
  helpText     String?
  questionType String             @default("SCALE_1_5") // SCALE_1_5 | YES_NO | TEXT
  weight       Float              @default(1)
  answers      AssessmentAnswer[]
}

model AssessmentResponse {
  id              String             @id @default(cuid())
  assessmentId    String
  assessment      Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  opdId           String
  opd             Opd                @relation(fields: [opdId], references: [id], onDelete: Cascade)
  submittedById   String?
  submittedBy     User?              @relation("ResponseSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  status          String             @default("DRAF") // DRAF | DIKIRIM | DIREVIU
  readinessScore  Float?             // Skor rata-rata kesiapan skala 1.00 - 5.00
  readinessPct    Int?               // Persentase kesiapan 0 - 100%
  summaryNotes    String?            // Catatan kendala umum dari Operator OPD
  pembinaFeedback String?            // Rekomendasi & tindak lanjut dari Pembina BPS
  reviewedById    String?
  reviewedBy      User?              @relation("ResponseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  answers         AssessmentAnswer[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([assessmentId, opdId])
}

model AssessmentAnswer {
  id           String             @id @default(cuid())
  responseId   String
  response     AssessmentResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId   String
  question     AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  scaleValue   Int?               // 1..5 untuk SCALE_1_5
  yesNoValue   String?            // "YA" | "TIDAK" untuk YES_NO
  textAnswer   String?            // Penjelasan / bukti pendukung / uraian kendala
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([responseId, questionId])
}

